# LingoBoardApi — environment variables.
# Copy to `.env` (git-ignored) and fill in locally. Never commit real values.
# Read via django-environ in LingoBoard/settings.py.

# --- Django core ------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True

# --- Database ---------------------------------------------------------------
# Parsed by env.db(). Example shape (no real credentials):
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- OpenAI (writing grading, utils/writing_grading_utils.py) ---------------
OPENAI_KEY=
